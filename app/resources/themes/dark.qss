/* ── Dark theme ──────────────────────────────────────────── */

QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QLabel {
    background: transparent;
}

QLineEdit {
    background: transparent;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 2px 6px;
    color: #d4d4d4;
}

/* Header */
#HeaderBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3a3a3a;
    min-height: 40px;
    max-height: 40px;
}

#HeaderBar QPushButton {
    background: transparent;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    color: #ccc;
    font-size: 16px;
}
#HeaderBar QPushButton:hover  { background-color: #3a3a3a; }
#HeaderBar QPushButton:pressed { background-color: #484848; }

/* Sidebar */
#SidePanel {
    background-color: #252526;
    border-right: 1px solid #3a3a3a;
}

#SidePanel QPushButton {
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 10px;
    border-radius: 4px;
    color: #ccc;
}
#SidePanel QPushButton:hover   { background-color: #2e2e2e; }
#SidePanel QPushButton:checked { background-color: #1e3a5f; color: #4ea1f3; font-weight: 600; }

/* Footer */
#FooterBar {
    background-color: #2d2d2d;
    border-top: 1px solid #3a3a3a;
    min-height: 24px;
    max-height: 24px;
}
#FooterBar QLabel { color: #888; font-size: 11px; padding: 0 8px; background: transparent; }
#FooterBar QPushButton {
    background: transparent;
    border: none;
    color: #888;
    font-size: 11px;
    padding: 0 6px;
}
#FooterBar QPushButton:hover { color: #ccc; }

#LogToggleBtn {
    background-color: #3a3a3a;
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    color: #ccc;
    font-size: 11px;
    padding: 0 8px;
}
#LogToggleBtn:hover { background-color: #484848; }
#LogToggleBtn:pressed { background-color: #555; }

/* Log panel */
#LogPanel {
    background-color: #2d2d2d;
    border-top: 1px solid #3a3a3a;
}
#LogHeader {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3a3a3a;
    min-height: 24px;
    max-height: 24px;
}
#LogBadge {
    color: #f59e0b;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
#LogFilterBtn {
    background-color: #3a3a3a;
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    color: #ccc;
    font-size: 12px;
    padding: 1px 4px;
    min-height: 18px;
}
#LogFilterBtn:hover   { background-color: #484848; }
#LogFilterBtn:checked { background-color: #1e3a5f; color: #4ea1f3; border-color: #2a5090; }
#LogFilterBtn:pressed { background-color: #555; }

#LogView {
    background-color: #252526;
    color: #d4d4d4;
    border: none;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}
#LogView QWidget { background-color: #252526; }

/* Toast — styled inline per instance (level-specific border color) */

/* Command palette */
#CommandPalette {
    background-color: #2d2d2d;
    border: 1px solid #555;
    border-radius: 8px;
}
#CommandPalette QLineEdit {
    border: none;
    border-bottom: 1px solid #444;
    padding: 10px 12px;
    font-size: 14px;
    background: transparent;
    color: #d4d4d4;
}
#CommandPalette QListWidget {
    border: none;
    background: transparent;
}
#CommandPalette QListWidget::item { padding: 6px 12px; color: #ccc; background: transparent; }
#CommandPalette QListWidget::item:selected { background-color: #1e3a5f; color: #4ea1f3; }

/* Notification history */
#NotificationHistory {
    background-color: #2d2d2d;
    border: 1px solid #555;
    border-radius: 6px;
}
#NotificationHistory QLabel { background: transparent; }

/* Body lifecycle overlays */
#LoadingOverlay, #ErrorOverlay {
    background-color: rgba(30, 30, 30, 200);
}

/* ── Games Hub ──────────────────────────────────────────────── */

/* Hub game card */
#GameCard {
    background-color: #252526;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
}
#GameCard:hover {
    background-color: #2a2d2e;
    border-color: #4ea1f3;
}

/* In-game top bar */
#GameTopBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3a3a3a;
}

/* Game-over overlay card */
#GameOverCard {
    background-color: #252526;
    border: 1px solid #3a3a3a;
    border-radius: 14px;
}
#GameOverTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #ef4444;
}
#GameOverGameName {
    font-size: 13px;
    color: #888;
}
#GameOverScore {
    font-size: 48px;
    font-weight: 700;
    color: #4ea1f3;
}
#GameOverScoreSub {
    font-size: 16px;
    color: #aaa;
}
#GameOverBest {
    font-size: 12px;
    color: #888;
}
#GameOverNewBest {
    font-size: 13px;
    font-weight: 600;
    color: #f59e0b;
}
#GameOverSep {
    background-color: #3a3a3a;
}
#GameOverRetryBtn {
    background-color: #1e3a5f;
    color: #4ea1f3;
    border: 1px solid #2a5090;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
#GameOverRetryBtn:hover  { background-color: #254870; }
#GameOverRetryBtn:pressed { background-color: #1a3050; }
#GameOverHubBtn {
    background-color: transparent;
    color: #888;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
}
#GameOverHubBtn:hover  { background-color: #2e2e2e; color: #ccc; }
#GameOverHubBtn:pressed { background-color: #3a3a3a; }

/* ── Modern widget kit ──────────────────────────────────────
   Shared look for subapps that call app.ui.widgets.mark_modern() on their
   root panel (sets modern="true"). */

*[modern="true"] QSplitter::handle { background: transparent; }
*[modern="true"] QWidget#Plain, *[modern="true"] #PortItem, *[modern="true"] QScrollArea#Scroll,
*[modern="true"] QScrollArea#Scroll > QWidget#qt_scrollarea_viewport,
*[modern="true"] QListWidget#PortList > QWidget#qt_scrollarea_viewport { background: transparent; }

*[modern="true"] QFrame#Card {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 10px;
}
*[modern="true"] QFrame#Card[state="drop"] { border: 1px dashed #4ea1f3; background-color: #1f2a36; }
*[modern="true"] #CardTitle  { color: #8a8a8a; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
*[modern="true"] #Hint       { color: #8a8a8a; }
*[modern="true"] #FieldLabel { color: #8a8a8a; font-size: 11px; }
*[modern="true"] #StatValue  { color: #e6e6e6; font-size: 15px; font-weight: 600; }
*[modern="true"] #StatValue[state="rec"] { color: #ef4444; }
*[modern="true"] #EmptyIcon  { font-size: 40px; color: #8a8a8a; }
*[modern="true"] #EmptyTitle { color: #e6e6e6; font-size: 16px; font-weight: 600; }
*[modern="true"] #Display    { color: #e6e6e6; font-size: 56px; font-weight: 300; }
*[modern="true"] #StatusText { color: #8a8a8a; }
*[modern="true"] #StatusText[state="error"] { color: #ef4444; }

/* buttons: plain = ghost, #PrimaryBtn = filled accent, #IconBtn = borderless */
*[modern="true"] QPushButton {
    background: transparent;
    color: #c8c8c8;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 5px 12px;
}
*[modern="true"] QPushButton:hover    { background-color: #2e2e2e; border-color: #4a4a4a; }
*[modern="true"] QPushButton:pressed  { background-color: #383838; }
*[modern="true"] QPushButton:disabled { color: #5a5a5a; border-color: #303030; }
*[modern="true"] QPushButton:checked  { background-color: #1e3a5f; color: #4ea1f3; border-color: #2a5090; }
*[modern="true"] QPushButton#PrimaryBtn {
    background-color: #4ea1f3;
    color: #0b1a2b;
    border: 1px solid #4ea1f3;
    border-radius: 8px;
    padding: 9px 22px;
    font-size: 14px;
    font-weight: 600;
}
*[modern="true"] QPushButton#PrimaryBtn:hover    { background-color: #6bb2f6; border-color: #6bb2f6; }
*[modern="true"] QPushButton#PrimaryBtn:pressed  { background-color: #3b8ad8; border-color: #3b8ad8; }
*[modern="true"] QPushButton#PrimaryBtn:disabled { background-color: #2c3742; border-color: #2c3742; color: #66727f; }
*[modern="true"] QPushButton#PrimaryBtn[compact="true"] { padding: 6px 16px; font-size: 13px; border-radius: 6px; }
*[modern="true"] QPushButton#PrimaryBtn[state="danger"] { background-color: #3b1f1f; color: #ef4444; border-color: #6b2b2b; }
*[modern="true"] QPushButton#PrimaryBtn[state="danger"]:hover { background-color: #4a2424; }
*[modern="true"] QPushButton#IconBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    color: #9a9a9a;
    font-size: 14px;
}
*[modern="true"] QPushButton#IconBtn:hover { background-color: #353535; color: #e6e6e6; }
*[modern="true"] QPushButton#IconBtn[kind="danger"]:hover { background-color: #3b1f1f; color: #ef4444; }

/* inputs */
*[modern="true"] QComboBox, *[modern="true"] QLineEdit, *[modern="true"] QSpinBox {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 5px 10px;
    color: #d4d4d4;
    selection-background-color: #264f78;
}
*[modern="true"] QComboBox:hover, *[modern="true"] QLineEdit:hover, *[modern="true"] QSpinBox:hover       { border-color: #4a4a4a; }
*[modern="true"] QComboBox:focus, *[modern="true"] QLineEdit:focus, *[modern="true"] QSpinBox:focus       { border-color: #4ea1f3; }
*[modern="true"] QComboBox:disabled, *[modern="true"] QLineEdit:disabled, *[modern="true"] QSpinBox:disabled { color: #5a5a5a; background-color: #262626; }
*[modern="true"] QLineEdit[readOnly="true"] { background-color: #2b2b2c; }
*[modern="true"] QComboBox::drop-down { border: none; width: 22px; }
*[modern="true"] QComboBox::down-arrow {
    image: url(@THEMES@/icons/chevron-down-dark.svg);
    width: 12px; height: 12px; margin-right: 8px;
}
*[modern="true"] QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    selection-background-color: #1e3a5f;
    selection-color: #4ea1f3;
    outline: 0;
}
*[modern="true"] QComboBox QLineEdit { background: transparent; border: none; padding: 0; }
*[modern="true"] QSpinBox::up-button, *[modern="true"] QSpinBox::down-button { width: 0; border: none; }

ToggleSwitch {
    background: transparent;
    color: #d4d4d4;
    qproperty-trackOn: #4ea1f3;
    qproperty-trackOff: #4a4a4a;
    qproperty-knob: #ffffff;
}

/* tabs as a segmented pill bar */
*[modern="true"] QTabWidget::pane { border: none; background: transparent; top: 6px; }
*[modern="true"] QTabWidget::tab-bar { left: 0px; }
*[modern="true"] QTabBar { background: transparent; }
*[modern="true"] QTabBar::tab {
    background: transparent;
    color: #8a8a8a;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 6px 16px;
    margin-right: 4px;
    font-weight: 600;
}
*[modern="true"] QTabBar::tab:hover    { color: #d4d4d4; background-color: #2e2e2e; }
*[modern="true"] QTabBar::tab:selected { color: #4ea1f3; background-color: #1e3a5f; border-color: #2a5090; }

/* port list */
*[modern="true"] QListWidget#PortList { background: transparent; border: none; outline: 0; }
*[modern="true"] QListWidget#PortList::item { border: 1px solid transparent; border-radius: 8px; margin: 2px 0; }
*[modern="true"] QListWidget#PortList::item:hover    { background-color: #2a2d2e; }
*[modern="true"] QListWidget#PortList::item:selected { background-color: #1e3a5f; border-color: #2a5090; }
*[modern="true"] #PortName { font-size: 14px; font-weight: 600; color: #e6e6e6; }
*[modern="true"] #PortDesc { color: #8a8a8a; font-size: 12px; }
*[modern="true"] #PortDot  { font-size: 10px; color: #8a8a8a; }
*[modern="true"] #PortDot[state="live"] { color: #22c55e; }
*[modern="true"] #PortDot[state="open"] { color: #4ea1f3; }

*[modern="true"] #Badge {
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 600;
    background-color: #333333;
    color: #aaaaaa;
}
*[modern="true"] #Badge[kind="esp"]    { background-color: #3a2a12; color: #f59e0b; }
*[modern="true"] #Badge[kind="bridge"] { background-color: #1e3a5f; color: #4ea1f3; }
*[modern="true"] #Badge[kind="live"]   { background-color: #163a24; color: #22c55e; }
*[modern="true"] #Badge[kind="rec"]    { background-color: #3b1f1f; color: #ef4444; }
*[modern="true"] #Badge[state="missing"] { background-color: #3b1f1f; color: #ef4444; }

*[modern="true"] QTextEdit#Console, *[modern="true"] QPlainTextEdit#Console {
    background-color: #1a1a1a;
    border: 1px solid #2f2f2f;
    border-radius: 8px;
    padding: 6px;
    font-family: "Consolas", monospace;
    font-size: 12px;
    color: #c8c8c8;
    selection-background-color: #264f78;
}
*[modern="true"] QTextEdit#Console:focus { border-color: #2a5090; }
*[modern="true"] #Plot { background: transparent; border: none; }

*[modern="true"] QScrollBar:vertical   { background: transparent; width: 10px; margin: 2px; }
*[modern="true"] QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
*[modern="true"] QScrollBar::handle    { background: #3e3e3e; border-radius: 3px; min-height: 24px; min-width: 24px; }
*[modern="true"] QScrollBar::handle:hover { background: #555555; }
*[modern="true"] QScrollBar::add-line, *[modern="true"] QScrollBar::sub-line { width: 0; height: 0; }
*[modern="true"] QScrollBar::add-page, *[modern="true"] QScrollBar::sub-page { background: none; }

/* hero status block: big stage title, detail line, percent, slim progress bar */
*[modern="true"] #HeroStage { font-size: 20px; font-weight: 600; color: #e6e6e6; }
*[modern="true"] #HeroStage[state="busy"]  { color: #4ea1f3; }
*[modern="true"] #HeroStage[state="ok"]    { color: #22c55e; }
*[modern="true"] #HeroStage[state="error"] { color: #ef4444; }
*[modern="true"] #HeroDetail { color: #8a8a8a; }
*[modern="true"] #HeroPercent { font-size: 26px; font-weight: 300; color: #e6e6e6; padding-right: 6px; }
*[modern="true"] QProgressBar#HeroProgress { background-color: #333333; border: none; border-radius: 4px; }
*[modern="true"] QProgressBar#HeroProgress::chunk { background-color: #4ea1f3; border-radius: 4px; }
*[modern="true"] QProgressBar#HeroProgress[state="ok"]::chunk    { background-color: #22c55e; }
*[modern="true"] QProgressBar#HeroProgress[state="error"]::chunk { background-color: #ef4444; }

/* file row: [name / folder · date] [size badge] — ESP Flasher images, OTA firmware */
*[modern="true"] QFrame#FileRow { background-color: #2b2b2c; border: 1px solid #353535; border-radius: 8px; }
*[modern="true"] QFrame#FileRow:hover { border-color: #454545; }
*[modern="true"] QFrame#FileRow[state="missing"] { border-color: #6b2b2b; }
*[modern="true"] QFrame#FileRow[state="warn"] { border-color: #f59e0b; }
*[modern="true"] #Badge[state="warn"] { background-color: #3a2a12; color: #f59e0b; }
*[modern="true"] #FileName { font-weight: 600; color: #e6e6e6; }
*[modern="true"] #FileDir  { color: #7d7d7d; font-size: 11px; }
*[modern="true"] #FileName[state="empty"] { color: #8a8a8a; font-weight: 400; font-style: italic; }
*[modern="true"] #FileWarning { color: #f59e0b; font-size: 11px; }

/* ── Programmer Calculator ──────────────────────────────────── */

*[modern="true"] QLineEdit#CalcInput {
    font-family: "Consolas", monospace;
    font-size: 20px;
    padding: 10px 14px;
    border-radius: 8px;
}
*[modern="true"] QLineEdit#CalcInput[state="error"] { border-color: #ef4444; }
*[modern="true"] #CalcValue { font-family: "Consolas", monospace; font-size: 17px; color: #e6e6e6; }
*[modern="true"] #CalcHistExpr { font-family: "Consolas", monospace; font-size: 13px; color: #e6e6e6; }
*[modern="true"] #CalcHistResult { font-family: "Consolas", monospace; font-size: 12px; color: #8a8a8a; }
*[modern="true"] QPushButton#CalcKey {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 0;
    font-family: "Consolas", monospace;
    font-size: 16px;
}
*[modern="true"] QPushButton#CalcKey:hover   { border-color: #4a4a4a; background-color: #333333; }
*[modern="true"] QPushButton#CalcKey:pressed { background-color: #383838; }
*[modern="true"] QPushButton#CalcKey[kind="op"]     { color: #4ea1f3; }
*[modern="true"] QPushButton#CalcKey[kind="muted"]  { color: #8a8a8a; }
*[modern="true"] QPushButton#CalcKey[kind="danger"] { color: #ef4444; }
*[modern="true"] QPushButton#CalcKey[kind="danger"]:hover { background-color: #3b1f1f; border-color: #6b2b2b; }

/* ── ESP Flasher ────────────────────────────────────────────── */

*[modern="true"] #FileName[state="disabled"], *[modern="true"] #FileDir[state="disabled"] { color: #5a5a5a; }
*[modern="true"] QComboBox#EfOffset { font-family: "Consolas", monospace; }
*[modern="true"] QComboBox#EfOffset[state="error"] { border-color: #ef4444; }

/* ── Scratchpad ──────────────────────────────── */

/* editor = console surface (keeps the app font), preview = card surface */
*[modern="true"] QPlainTextEdit#SpEditor {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 6px 8px;
    color: #c8c8c8;
    selection-background-color: #264f78;
}
*[modern="true"] QPlainTextEdit#SpEditor:focus { border-color: #4ea1f3; }
*[modern="true"] QTextBrowser#SpPreview {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 6px 8px;
    color: #d4d4d4;
    selection-background-color: #264f78;
}

/* Edit / Preview: kit ghost buttons, pill-shaped like the tabs */
*[modern="true"] QPushButton#SpModeBtn { padding: 5px 14px; border-radius: 7px; }

/* tag filter chips: neutral pill, accent when checked */
*[modern="true"] QPushButton#SpTagChip {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 11px;
    padding: 2px 10px;
    font-size: 12px;
}
*[modern="true"] QPushButton#SpTagChip:hover   { border-color: #8a8a8a; color: #e6e6e6; }
*[modern="true"] QPushButton#SpTagChip:checked { background-color: #1e3a5f; color: #4ea1f3; border-color: #4ea1f3; }

/* quick-open / command palette popups (top-level; draw a Card on a clear window) */
*[modern="true"]#SpPopup { background: transparent; }
*[modern="true"] #SpRowText { color: #d4d4d4; }
*[modern="true"] #SpRowText[state="disabled"] { color: #8a8a8a; }
*[modern="true"] #SpRowMeta { color: #8a8a8a; font-size: 11px; }

/* note tabs: kit pill tabs, room on the right for a themed close button */
*[modern="true"] QTabBar#SpTabBar::tab { padding: 6px 8px 6px 14px; }
*[modern="true"] QPushButton#SpTabClose {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    min-width: 16px; max-width: 16px;
    min-height: 16px; max-height: 16px;
    color: #8a8a8a;
    font-size: 11px;
}
*[modern="true"] QPushButton#SpTabClose:hover { color: #ef4444; }
